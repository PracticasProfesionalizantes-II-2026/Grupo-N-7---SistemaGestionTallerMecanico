@model IEnumerable<TallerMecanicoFront.Models.TrabajoPorTurno>
@{
    ViewData["Title"] = "Trabajos por Turno";
    var turnosBloqueados = ViewBag.TurnosBloqueados as HashSet<int> ?? new HashSet<int>();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Trabajos por Turno</h1>
    <a asp-action="Create" class="btn btn-primary">Nuevo Trabajo por Turno</a>
</div>

@if (TempData["Error"] is not null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="table-responsive tabla-scroll">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Id</th>
                <th>Turno</th>
                <th>Trabajo</th>
                <th>Usuario</th>
                <th>Hs. Hombre</th>
                <th>Tarifa</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.IdTurno</td>
                        <td>@item.IdTrabajo</td>
                        <td>@item.IdUsuario</td>
                        <td>@item.HsHombre.ToString("0.00")</td>
                        <td>$@item.TarifaHsHombre.ToString("0.00")</td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-2">
                                @if (!turnosBloqueados.Contains(item.IdTurno))
                                {
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('¿Seguro que deseas eliminar este trabajo por turno?');">Eliminar</button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" class="text-center text-muted py-4">No hay trabajos por turno registrados.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
