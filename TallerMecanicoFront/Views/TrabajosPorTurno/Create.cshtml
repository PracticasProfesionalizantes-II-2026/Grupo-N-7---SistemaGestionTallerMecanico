@model TallerMecanicoFront.Models.TrabajoPorTurno
@using TallerMecanicoFront.Models
@using System.Globalization
@{
    ViewData["Title"] = "Crear Trabajo por Turno";
    var turnos = ViewBag.Turnos as IEnumerable<Turno> ?? Enumerable.Empty<Turno>();
    var trabajos = ViewBag.Trabajos as IEnumerable<Trabajo> ?? Enumerable.Empty<Trabajo>();
    var usuarios = ViewBag.Usuarios as IEnumerable<Usuario> ?? Enumerable.Empty<Usuario>();
}

<div class="row justify-content-center">
    <div class="col-12 col-xl-9">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h1 class="h4 mb-4">Nuevo Trabajo por Turno</h1>
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="IdTurno" class="form-label">Turno</label>
                            <input asp-for="IdTurno" type="hidden" />
                            <select asp-for="IdTurno" class="form-select" disabled>
                                <option value="">Seleccione un turno</option>
                                @foreach (var turno in turnos)
                                {
                                    <option value="@turno.Id">Turno N° @turno.Id - Fecha @turno.Fecha.ToString("dd/MM/yyyy")</option>
                                }
                            </select>
                            <span asp-validation-for="IdTurno" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="IdTrabajo" class="form-label">Trabajo</label>
                            <select asp-for="IdTrabajo" class="form-select" required>
                                <option value="">Seleccione un trabajo</option>
                                @foreach (var trabajo in trabajos)
                                {
                                    <option value="@trabajo.Id" data-precio="@trabajo.PrecioHsManoObra.ToString(CultureInfo.InvariantCulture)">@trabajo.Nombre</option>
                                }
                            </select>
                            <span asp-validation-for="IdTrabajo" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="IdUsuario" class="form-label">Usuario</label>
                            <select asp-for="IdUsuario" class="form-select" required>
                                <option value="">Seleccione un usuario</option>
                                @foreach (var usuario in usuarios)
                                {
                                    <option value="@usuario.Id">@usuario.Apellido, @usuario.Nombre</option>
                                }
                            </select>
                            <span asp-validation-for="IdUsuario" class="text-danger"></span>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="HsHombre" class="form-label">Hs. Hombre</label>
                            <input asp-for="HsHombre" type="number" step="0.01" min="0.01" class="form-control" required />
                            <span asp-validation-for="HsHombre" class="text-danger"></span>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="TarifaHsHombre" class="form-label">Tarifa</label>
                            <input asp-for="TarifaHsHombre" type="number" step="0.01" min="0" class="form-control" readonly required />
                            <span asp-validation-for="TarifaHsHombre" class="text-danger"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Descripcion" class="form-label"></label>
                            <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Descripcion" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary">Guardar</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }

<script>
    const trabajoSelect = document.getElementById("IdTrabajo");
    const hsHombreInput = document.getElementById("HsHombre");
    const tarifaInput = document.getElementById("TarifaHsHombre");

    function actualizarTarifa() {
        const precio = Number(trabajoSelect.selectedOptions[0]?.dataset.precio || 0);
        const hsHombre = Number(hsHombreInput.value || 0);
        tarifaInput.value = (hsHombre * precio).toFixed(2);
    }

    trabajoSelect.addEventListener("change", actualizarTarifa);
    hsHombreInput.addEventListener("input", actualizarTarifa);
    actualizarTarifa();
</script>
