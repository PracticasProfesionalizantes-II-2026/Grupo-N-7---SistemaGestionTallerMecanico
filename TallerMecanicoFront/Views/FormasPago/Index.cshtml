@model IEnumerable<TallerMecanicoFront.Models.FormaPago>
@{
    ViewData["Title"] = "Formas de Pago";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Formas de Pago</h1>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle-fill"></i> Nueva Forma de Pago</a>
</div>

@if (TempData["Error"] is not null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-octagon-fill"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

@if (!ViewData.ModelState.IsValid)
{
    <div asp-validation-summary="All" class="alert alert-danger"></div>
}

<div class="table-responsive tabla-scroll">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Id</th>
                <th>Nombre</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.Nombre</td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-2">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                                <button type="button" class="btn btn-sm btn-outline-danger"
                                        data-confirmar-baja
                                        data-baja-url="@Url.Action("Delete", new { id = item.Id })"
                                        data-pendientes-url="@Url.Action("Verificar", "Bajas", new { entidad = "formapago", id = item.Id })"
                                        data-nombre="@item.Nombre"
                                        data-eliminacion="true">
                                    Eliminar
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="3" class="text-center text-muted py-4">No hay formas de pago registradas.</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<partial name="_ConfirmarBajaModal" />
