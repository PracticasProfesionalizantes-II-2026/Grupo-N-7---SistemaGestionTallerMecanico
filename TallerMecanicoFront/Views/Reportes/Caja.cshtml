@model TallerMecanicoFront.Models.ReporteCaja
@{
    ViewData["Title"] = "Ingreso / Egreso";
}

<h1 class="h3 mb-4">INGRESO / EGRESO</h1>

@if (!ViewData.ModelState.IsValid)
{
    <div asp-validation-summary="All" class="alert alert-danger"></div>
}

<form method="get" asp-action="Caja" class="row row-cols-auto g-3 align-items-end mb-4">
    <div class="col">
        <label class="form-label fw-semibold">Fecha inicial</label>
        <input type="date" name="fechaInicio" class="form-control" value="@Model.FechaInicio.ToString("yyyy-MM-dd")" />
    </div>
    <div class="col">
        <label class="form-label fw-semibold">Fecha Final</label>
        <input type="date" name="fechaFin" class="form-control" value="@Model.FechaFin.ToString("yyyy-MM-dd")" />
    </div>
    <div class="col">
        <button type="submit" class="btn btn-outline-dark">
            <i class="bi bi-search"></i>
        </button>
    </div>
</form>

<div class="bg-white border rounded p-4" style="max-width: 640px;">
    <div class="d-flex justify-content-between align-items-start mb-3">
        <div>
            <div class="text-muted small">Profit</div>
            <div class="fs-3 fw-bold">$@Model.Balance.ToString("N2")</div>
        </div>
        @{
            var tasa = Model.TotalIngresos > 0
                ? Math.Round((Model.Balance / Model.TotalIngresos) * 100, 1)
                : 0;
        }
        <span class="badge @(Model.Balance >= 0 ? "text-bg-success" : "text-bg-danger")">
            <i class="bi bi-arrow-@(Model.Balance >= 0 ? "up" : "down")"></i> Profit rate @tasa%
        </span>
    </div>

    <div class="d-flex gap-4 mb-3">
        <div>
            <div class="text-muted small">Income</div>
            <div class="fw-semibold text-success">$@Model.TotalIngresos.ToString("N2")</div>
        </div>
        <div>
            <div class="text-muted small">Expense</div>
            <div class="fw-semibold text-danger">-$@Model.TotalEgresos.ToString("N2")</div>
        </div>
    </div>

    @if (Model.Serie.Any())
    {
        <canvas id="graficoCaja" height="180"></canvas>
    }
    else
    {
        <p class="text-muted mb-0">No hay movimientos de caja en el rango seleccionado.</p>
    }
</div>

@section Scripts {
    @if (Model.Serie.Any())
    {
        <script src="~/lib/chart.js/chart.umd.min.js"></script>
        <script>
            const etiquetas = @Html.Raw(Json.Serialize(Model.Serie.Select(p => p.Periodo.ToString("MMM")).ToList()));
            const ingresos = @Html.Raw(Json.Serialize(Model.Serie.Select(p => p.Ingresos).ToList()));
            const egresos = @Html.Raw(Json.Serialize(Model.Serie.Select(p => p.Egresos).ToList()));

            new Chart(document.getElementById('graficoCaja'), {
                type: 'bar',
                data: {
                    labels: etiquetas,
                    datasets: [
                        { label: 'Income', data: ingresos, backgroundColor: '#3ddc84' },
                        { label: 'Expense', data: egresos, backgroundColor: '#ff5c5c' }
                    ]
                },
                options: {
                    indexAxis: 'y',
                    responsive: true,
                    scales: { x: { beginAtZero: true } }
                }
            });
        </script>
    }
}
