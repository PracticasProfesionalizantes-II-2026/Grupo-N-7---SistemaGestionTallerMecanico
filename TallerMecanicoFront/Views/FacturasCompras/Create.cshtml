@model TallerMecanicoFront.Models.FacturaCompra
@using TallerMecanicoFront.Models
@{
    ViewData["Title"] = "Crear Factura de Compra";
    var proveedores = ViewBag.Proveedores as IEnumerable<Proveedor> ?? Enumerable.Empty<Proveedor>();
    var sesiones = ViewBag.SesionesCaja as IEnumerable<SesionCaja> ?? Enumerable.Empty<SesionCaja>();
    var formasPago = ViewBag.FormasPago as IEnumerable<FormaPago> ?? Enumerable.Empty<FormaPago>();
}

<div class="row justify-content-center">
    <div class="col-12 col-xl-9">
        <div class="card shadow-sm border-0"><div class="card-body p-4">
            <h1 class="h4 mb-4">Nueva Factura de Compra</h1>
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="row g-3">
                    <div class="col-md-6"><label asp-for="IdProveedor" class="form-label">Proveedor</label><select asp-for="IdProveedor" class="form-select" required><option value="">Seleccione un proveedor</option>@foreach (var proveedor in proveedores){<option value="@proveedor.Id">@proveedor.Apellido, @proveedor.Nombre</option>}</select><span asp-validation-for="IdProveedor" class="text-danger"></span></div>
                    <div class="col-md-6"><label asp-for="IdSesionCaja" class="form-label">Sesión de caja</label><select asp-for="IdSesionCaja" class="form-select" required><option value="">Seleccione una sesión</option>@foreach (var sesion in sesiones){<option value="@sesion.Id">#@sesion.Id - @sesion.FechaInicio.ToString("dd/MM/yyyy HH:mm")</option>}</select><span asp-validation-for="IdSesionCaja" class="text-danger"></span></div>
                    <div class="col-md-4"><label asp-for="FechaFactura" class="form-label">Fecha de factura</label><input asp-for="FechaFactura" type="date" class="form-control" required /><span asp-validation-for="FechaFactura" class="text-danger"></span></div>
                    <div class="col-md-4"><label asp-for="TotalFactura" class="form-label">Total</label><input asp-for="TotalFactura" type="number" step="0.01" min="0" class="form-control" required /><span asp-validation-for="TotalFactura" class="text-danger"></span></div>
                    <div class="col-md-4"><label asp-for="IdFormaPago" class="form-label">Forma de pago</label><select asp-for="IdFormaPago" class="form-select" required><option value="">Seleccione una forma de pago</option>@foreach (var forma in formasPago){<option value="@forma.Id">@forma.Nombre</option>}</select><span asp-validation-for="IdFormaPago" class="text-danger"></span></div>
                    <div class="col-md-6"><div class="form-check mt-2"><input asp-for="Pagado" class="form-check-input" id="pagado" /><label asp-for="Pagado" class="form-check-label">Factura pagada</label></div></div>
                    <div class="col-md-6"><label asp-for="FechaPagoFactura" class="form-label">Fecha de pago</label><input asp-for="FechaPagoFactura" type="date" class="form-control" /></div>
                </div>
                <div class="d-flex gap-2 mt-4"><button type="submit" class="btn btn-primary">Guardar</button><a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a></div>
            </form>
        </div></div>
    </div>
</div>

@section Scripts {<partial name="_ValidationScriptsPartial" />}
