@model IEnumerable<TallerMecanicoFront.Models.DetalleFacturaVenta>
@{
    ViewData["Title"] = "Detalles de Facturas de Venta";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Detalles de Facturas de Venta</h1>
    <a asp-action="Create" class="btn btn-primary">Nuevo Detalle</a>
</div>

@if (TempData["Error"] is not null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (!ViewData.ModelState.IsValid)
{
    <div asp-validation-summary="All" class="alert alert-danger"></div>
}

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Id</th>
                <th>Factura</th>
                <th>Trabajo</th>
                <th>Insumo</th>
                <th>Descripción</th>
                <th>Cantidad</th>
                <th>Precio unitario</th>
                <th>Total</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.IdFactura</td>
                        <td>@(item.IdTrabajoPorTurno ?? 0)</td>
                        <td>@(item.IdInsumoPorTrabajo ?? 0)</td>
                        <td>@item.DescripcionItem</td>
                        <td>@item.Cantidad</td>
                        <td>@item.PrecioUnitario.ToString("C2")</td>
                        <td>@item.TotalDetalle.ToString("C2")</td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-2">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('¿Seguro que deseas eliminar este detalle de factura de venta?');">Eliminar</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="9" class="text-center text-muted py-4">No hay detalles de facturas de venta registrados.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
