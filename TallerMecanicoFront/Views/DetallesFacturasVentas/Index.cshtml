@model TallerMecanicoFront.Models.FacturaVentaDetalle
@{
    ViewData["Title"] = "Detalle de factura de venta";
    var facturaPagada = Convert.ToBoolean(ViewBag.FacturaPagada ?? false);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-1">Detalle de factura de venta</h1>
        <div class="text-muted">Factura N° @Model.IdFactura · Turno N° @Model.IdTurno</div>
    </div>
    <a asp-controller="FacturasVentas" asp-action="Index" class="btn btn-outline-secondary">Volver a facturas</a>
</div>

@if (TempData["Error"] is not null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (!ViewData.ModelState.IsValid)
{
    <div asp-validation-summary="All" class="alert alert-danger"></div>
}

@if (facturaPagada)
{
    <div class="alert alert-info">La factura está pagada. Sus conceptos no se pueden editar ni eliminar.</div>
}

<div class="table-responsive tabla-scroll">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Concepto</th>
                <th>Cantidad</th>
                <th>Precio unitario</th>
                <th>Total</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var trabajo in Model.Trabajos)
            {
                <tr>
                    <td>@trabajo.NombreTrabajo</td>
                    <td>@trabajo.Horas.ToString("0")</td>
                    <td>$@trabajo.PrecioUnitario.ToString("0.00")</td>
                    <td>$@trabajo.Total.ToString("0.00")</td>
                </tr>
            }
            @foreach (var insumo in Model.Insumos)
            {
                <tr>
                    <td>@insumo.NombreInsumo</td>
                    <td>@insumo.Cantidad.ToString("0")</td>
                    <td>$@insumo.PrecioUnitario.ToString("0.00")</td>
                    <td>$@insumo.Total.ToString("0.00")</td>
                </tr>
            }
        </tbody>
        <tfoot class="table-light">
            <tr>
                <th colspan="3" class="text-end">Total de la factura</th>
                <th>$@Model.TotalFactura.ToString("0.00")</th>
            </tr>
        </tfoot>
    </table>
</div>

