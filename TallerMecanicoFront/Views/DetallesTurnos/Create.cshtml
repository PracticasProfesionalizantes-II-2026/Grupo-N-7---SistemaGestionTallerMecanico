@model TallerMecanicoFront.Models.DetalleTurno
@using TallerMecanicoFront.Models
@{
    ViewData["Title"] = "Crear Detalle de Turno";
    var turnos = ViewBag.Turnos as IEnumerable<Turno> ?? Enumerable.Empty<Turno>();
    var localidades = ViewBag.Localidades as IEnumerable<Localidad> ?? Enumerable.Empty<Localidad>();
}

<div class="row justify-content-center">
    <div class="col-12 col-xl-9">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h1 class="h4 mb-4">Nuevo Detalle de Turno</h1>
                <form asp-action="Create" method="post">
                    <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="IdTurno" class="form-label">Turno</label>
                            <input asp-for="IdTurno" type="hidden" />
                            <select asp-for="IdTurno" class="form-select" disabled>
                                <option value="">Seleccione un turno</option>
                                @foreach (var turno in turnos)
                                {
                                    <option value="@turno.Id">Turno N° @turno.Id - Fecha @turno.Fecha.ToString("dd/MM/yyyy")</option>
                                }
                            </select>
                            <span asp-validation-for="IdTurno" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="IdLocalidad" class="form-label">Localidad</label>
                            <div class="input-group">
                                <select asp-for="IdLocalidad" class="form-select">
                                    <option value="">Seleccione una localidad</option>
                                    @foreach (var localidad in localidades)
                                    {
                                        <option value="@localidad.Id">@localidad.Nombre</option>
                                    }
                                </select>
                                <a asp-controller="Localidades" asp-action="Create" asp-route-returnUrl="@Context.Request.Path@Context.Request.QueryString" class="btn btn-outline-secondary" title="Agregar localidad">Nueva</a>
                            </div>
                            <span asp-validation-for="IdLocalidad" class="text-danger"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="DomicilioTrabajo" class="form-label">Domicilio de trabajo</label>
                            <textarea asp-for="DomicilioTrabajo" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="DomicilioTrabajo" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-center gap-5 mt-5">
                        <button type="submit" class="btn btn-success">Guardar</button>
                        @if (ViewData["ReturnUrl"] is string returnUrl)
                        {
                            <a href="@returnUrl" class="btn btn-danger">Cancelar</a>
                        }
                        else
                        {
                            <a asp-action="Index" class="btn btn-danger">Cancelar</a>
                        }
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
