@model IEnumerable<TallerMecanicoFront.Models.DetalleTurno>
@{
    ViewData["Title"] = "Detalles de Turno";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Detalles de Turno</h1>
    <a asp-action="Create" class="btn btn-primary">Nuevo Detalle</a>
</div>

@if (TempData["Error"] is not null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Id</th>
                <th>Turno</th>
                <th>Domicilio</th>
                <th>Localidad</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.IdTurno</td>
                        <td>@(string.IsNullOrWhiteSpace(item.DomicilioTrabajo) ? "-" : item.DomicilioTrabajo)</td>
                        <td>@(item.IdLocalidad ?? 0)</td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-2">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('¿Seguro que deseas eliminar este detalle de turno?');">Eliminar</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center text-muted py-4">No hay detalles de turno registrados.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
