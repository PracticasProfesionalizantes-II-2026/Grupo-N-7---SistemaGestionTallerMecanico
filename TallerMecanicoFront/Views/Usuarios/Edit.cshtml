@model TallerMecanicoFront.Models.Usuario
@using TallerMecanicoFront.Models
@{
    ViewData["Title"] = "Editar Usuario";
    var localidades = ViewBag.Localidades as IEnumerable<Localidad> ?? Enumerable.Empty<Localidad>();
    var roles = ViewBag.Roles as IEnumerable<Rol> ?? Enumerable.Empty<Rol>();
}

<div class="row justify-content-center">
    <div class="col-12 col-xl-9">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h1 class="h4 mb-4">Editar Usuario</h1>
                <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                    <input asp-for="Id" type="hidden" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <div class="row g-3">
                        <div class="col-md-6"><label asp-for="Nombre" class="form-label"></label><input asp-for="Nombre" class="form-control" maxlength="100" required /><span asp-validation-for="Nombre" class="text-danger"></span></div>
                        <div class="col-md-6"><label asp-for="Apellido" class="form-label"></label><input asp-for="Apellido" class="form-control" maxlength="100" required /><span asp-validation-for="Apellido" class="text-danger"></span></div>
                        <div class="col-md-8"><label asp-for="Domicilio" class="form-label"></label><input asp-for="Domicilio" class="form-control" maxlength="200" required /><span asp-validation-for="Domicilio" class="text-danger"></span></div>
                        <div class="col-md-4"><label asp-for="IdLocalidad" class="form-label">Localidad</label><div class="input-group"><select asp-for="IdLocalidad" class="form-select" required><option value="">Seleccione una localidad</option>@foreach (var localidad in localidades){<option value="@localidad.Id">@localidad.Nombre - @localidad.Provincia</option>}</select><a asp-controller="Localidades" asp-action="Create" asp-route-returnUrl="@Context.Request.Path@Context.Request.QueryString" class="btn btn-outline-secondary" title="Agregar localidad">Nueva</a></div><span asp-validation-for="IdLocalidad" class="text-danger"></span></div>
                        <div class="col-md-6"><label asp-for="Telefono" class="form-label"></label><input asp-for="Telefono" class="form-control" maxlength="20" /></div>
                        <div class="col-md-6"><label asp-for="Correo" class="form-label"></label><input asp-for="Correo" type="email" class="form-control" maxlength="100" required /><span asp-validation-for="Correo" class="text-danger"></span></div>
                        <div class="col-md-6"><label asp-for="Dni" class="form-label"></label><input asp-for="Dni" class="form-control" maxlength="15" required /><span asp-validation-for="Dni" class="text-danger"></span></div>
                        <div class="col-md-6"><label asp-for="FechaNacimiento" class="form-label">Fecha de nacimiento</label><input asp-for="FechaNacimiento" type="date" class="form-control" /></div>
                        <div class="col-md-6"><label asp-for="IdRol" class="form-label">Rol</label><div class="input-group"><select asp-for="IdRol" class="form-select" required><option value="">Seleccione un rol</option>@foreach (var rol in roles){<option value="@rol.Id">@rol.Nombre</option>}</select><a asp-controller="Roles" asp-action="Create" asp-route-returnUrl="@Context.Request.Path@Context.Request.QueryString" class="btn btn-outline-secondary" title="Agregar rol">Nuevo</a></div><span asp-validation-for="IdRol" class="text-danger"></span></div>
                        <div class="col-md-6"><label asp-for="ContraseñaHash" class="form-label">Contraseña</label><input id="ContraseñaHash" name="ContraseñaHash" type="text" class="form-control" value="@Model.ContraseñaHash" minlength="5" maxlength="255" required /><span asp-validation-for="ContraseñaHash" class="text-danger"></span></div>
                    </div>
                    <div class="form-check mt-4 mb-4"><input asp-for="Activo" class="form-check-input" /><label asp-for="Activo" class="form-check-label">Usuario activo</label></div>
                    <div class="d-flex justify-content-center gap-5 mt-5"><button type="submit" class="btn btn-success">Guardar</button><a asp-action="Index" class="btn btn-danger">Cancelar</a></div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
