@model TallerMecanicoFront.Models.FacturaVenta
@using TallerMecanicoFront.Models
@{
    ViewData["Title"] = "Editar Factura de Venta";
    var clientes = ViewBag.Clientes as IEnumerable<Cliente> ?? Enumerable.Empty<Cliente>();
    var turnos = ViewBag.Turnos as IEnumerable<Turno> ?? Enumerable.Empty<Turno>();
    var sesiones = ViewBag.SesionesCaja as IEnumerable<SesionCaja> ?? Enumerable.Empty<SesionCaja>();
    var formasPago = ViewBag.FormasPago as IEnumerable<FormaPago> ?? Enumerable.Empty<FormaPago>();
}

<div class="row justify-content-center">
    <div class="col-12 col-xl-9">
        <div class="card shadow-sm border-0"><div class="card-body p-4">
            <h1 class="h4 mb-4">Editar Factura de Venta</h1>
            <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                <input asp-for="Id" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="row g-3">
                    <div class="col-md-6"><label asp-for="IdCliente" class="form-label">Cliente</label><div class="input-group"><select asp-for="IdCliente" class="form-select" required><option value="">Seleccione un cliente</option>@foreach (var cliente in clientes){<option value="@cliente.Id">@cliente.Apellido, @cliente.Nombre</option>}</select><a asp-controller="Clientes" asp-action="Create" asp-route-returnUrl="@Context.Request.Path@Context.Request.QueryString" class="btn btn-outline-secondary" title="Agregar cliente">Nuevo</a></div><span asp-validation-for="IdCliente" class="text-danger"></span></div>
                    <div class="col-md-6"><label asp-for="IdTurno" class="form-label">Turno</label><select asp-for="IdTurno" class="form-select" required><option value="">Seleccione un turno</option>@foreach (var turno in turnos){<option value="@turno.Id">#@turno.Id - @turno.Fecha.ToString("dd/MM/yyyy HH:mm")</option>}</select><span asp-validation-for="IdTurno" class="text-danger"></span></div>
                    <div class="col-md-6"><label asp-for="IdSesionCaja" class="form-label">Sesión de caja</label><select asp-for="IdSesionCaja" class="form-select" required><option value="">Seleccione una sesión</option>@foreach (var sesion in sesiones){<option value="@sesion.Id">#@sesion.Id - @sesion.FechaInicio.ToString("dd/MM/yyyy HH:mm")</option>}</select><span asp-validation-for="IdSesionCaja" class="text-danger"></span></div>
                    <div class="col-md-6"><label asp-for="IdFormaPago" class="form-label">Forma de pago</label><div class="input-group"><select asp-for="IdFormaPago" class="form-select" required><option value="">Seleccione una forma de pago</option>@foreach (var forma in formasPago){<option value="@forma.Id">@forma.Nombre</option>}</select><a asp-controller="FormasPago" asp-action="Create" asp-route-returnUrl="@Context.Request.Path@Context.Request.QueryString" class="btn btn-outline-secondary" title="Agregar forma de pago">Nueva</a></div><span asp-validation-for="IdFormaPago" class="text-danger"></span></div>
                    <div class="col-md-4"><label asp-for="FechaEmision" class="form-label">Fecha de emisión</label><input asp-for="FechaEmision" type="date" class="form-control" required /><span asp-validation-for="FechaEmision" class="text-danger"></span></div>
                    <div class="col-md-4"><label asp-for="TotalFactura" class="form-label">Total</label><input asp-for="TotalFactura" type="number" step="0.01" min="0" class="form-control" disabled /><span asp-validation-for="TotalFactura" class="text-danger"></span></div>
                    <div class="col-md-4"><label asp-for="FechaPagoFactura" class="form-label">Fecha de pago</label><input asp-for="FechaPagoFactura" type="date" class="form-control" /></div>
                </div>
                <div class="form-check mt-4 mb-4"><input asp-for="Pagado" class="form-check-input" /><label asp-for="Pagado" class="form-check-label">Factura pagada</label></div>
                <div class="d-flex gap-2"><button type="submit" class="btn btn-primary">Guardar Cambios</button><a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a></div>
            </form>
        </div></div>
    </div>
</div>

@section Scripts {<partial name="_ValidationScriptsPartial" />}
