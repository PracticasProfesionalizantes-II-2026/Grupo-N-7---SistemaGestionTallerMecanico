@model IEnumerable<TallerMecanicoFront.Models.FacturaVenta>
@using TallerMecanicoFront.Models
@{
    ViewData["Title"] = "Facturas de Venta";
    var estadoActual = (ViewBag.Estado as string) ?? "todas";
    var busquedaActual = (ViewBag.Buscar as string) ?? string.Empty;

    var clientes = (ViewBag.Clientes as IEnumerable<Cliente> ?? Enumerable.Empty<Cliente>())
        .GroupBy(c => c.Id).ToDictionary(g => g.Key, g => g.First());
    var formasPago = (ViewBag.FormasPago as IEnumerable<FormaPago> ?? Enumerable.Empty<FormaPago>())
        .GroupBy(f => f.Id).ToDictionary(g => g.Key, g => g.First());
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Facturas de Venta</h1>
    <a asp-action="Create" class="btn btn-primary">Nueva Factura</a>
</div>

@if (TempData["Error"] is not null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (!ViewData.ModelState.IsValid)
{
    <div asp-validation-summary="All" class="alert alert-danger"></div>
}

<form method="get" asp-action="Index" class="row row-cols-auto g-3 align-items-end mb-4">
    <div class="col">
        <label class="form-label fw-semibold">Buscar</label>
        <div class="input-group">
            <span class="input-group-text bg-white text-muted"><i class="bi bi-search"></i></span>
            <input type="text"
                   name="buscar"
                   class="form-control"
                   placeholder="Cliente, CUIT o N°..."
                   value="@busquedaActual" />
        </div>
    </div>
    <div class="col">
        <label class="form-label fw-semibold">Estado</label>
        <select name="estado" class="form-select">
            <!option value="todas" @(estadoActual == "todas" ? "selected" : "")>Todas</!option>
            <!option value="pendientes" @(estadoActual == "pendientes" ? "selected" : "")>Solo pendientes</!option>
            <!option value="pagadas" @(estadoActual == "pagadas" ? "selected" : "")>Solo pagadas</!option>
        </select>
    </div>
    <div class="col">
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-search"></i> Buscar
        </button>
        @if (!string.IsNullOrWhiteSpace(busquedaActual) || estadoActual != "todas")
        {
            <a asp-action="Index" class="btn btn-outline-secondary ms-1">
                <i class="bi bi-x-circle"></i> Limpiar
            </a>
        }
    </div>
</form>

<div class="table-responsive tabla-scroll">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Id</th>
                <th>Fecha de emisión</th>
                <th>Cliente</th>
                <th>Turno</th>
                <th>Total</th>
                <th>Forma de pago</th>
                <th>Estado</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Any())
            {
                foreach (var item in Model)
                {
                    var clienteTexto = clientes.TryGetValue(item.IdCliente, out var cli)
                        ? $"{cli.Apellido}, {cli.Nombre}"
                        : $"#{item.IdCliente}";

                    var formaPagoTexto = formasPago.TryGetValue(item.IdFormaPago, out var fp)
                        ? fp.Nombre
                        : $"#{item.IdFormaPago}";

                    <tr>
                        <td>@item.Id</td>
                        <td>@item.FechaEmision.ToString("dd/MM/yyyy")</td>
                        <td>@clienteTexto</td>
                        <td>#@item.IdTurno</td>
                        <td>$@item.TotalFactura.ToString("0.00")</td>
                        <td>@formaPagoTexto</td>
                        <td>
                            @if (item.Pagado)
                            {
                                <span class="badge text-bg-success">Pagada</span>
                            }
                            else
                            {
                                <span class="badge text-bg-warning">Pendiente</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-2">
                                <a asp-controller="DetallesFacturasVentas" asp-action="Index" asp-route-facturaId="@item.Id" class="btn btn-sm btn-outline-success">Ver detalle</a>
                                @if (!item.Pagado)
                                {
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('¿Seguro que deseas eliminar esta factura de venta?');">Eliminar</button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="8" class="text-center text-muted py-4">
                        @if (!string.IsNullOrWhiteSpace(busquedaActual) || estadoActual != "todas")
                        {
                            <span>No se encontraron facturas de venta con los filtros seleccionados.</span>
                        }
                        else
                        {
                            <span>No hay facturas de venta registradas.</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
