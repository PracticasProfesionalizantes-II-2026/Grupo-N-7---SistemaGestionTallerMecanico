@model IEnumerable<TallerMecanicoFront.Models.FacturaVenta>
@{
    ViewData["Title"] = "Facturas de Venta";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Facturas de Venta</h1>
    <a asp-action="Create" class="btn btn-primary">Nueva Factura</a>
</div>

@if (TempData["Error"] is not null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (!ViewData.ModelState.IsValid)
{
    <div asp-validation-summary="All" class="alert alert-danger"></div>
}

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Id</th>
                <th>Fecha de emisión</th>
                <th>Cliente</th>
                <th>Turno</th>
                <th>Total</th>
                <th>Forma de pago</th>
                <th>Estado</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.FechaEmision.ToString("dd/MM/yyyy")</td>
                        <td>@item.IdCliente</td>
                        <td>@item.IdTurno</td>
                        <td>@item.TotalFactura.ToString("C2")</td>
                        <td>@item.IdFormaPago</td>
                        <td>
                            @if (item.Pagado)
                            {
                                <span class="badge text-bg-success">Pagada</span>
                            }
                            else
                            {
                                <span class="badge text-bg-warning">Pendiente</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-2">
                                @if (!item.Pagado)
                                {
                                    <a asp-controller="DetallesFacturasVentas" asp-action="Create" asp-route-facturaId="@item.Id" class="btn btn-sm btn-outline-success">Agregar detalle</a>
                                }
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('¿Seguro que deseas eliminar esta factura de venta?');">Eliminar</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="8" class="text-center text-muted py-4">No hay facturas de venta registradas.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
