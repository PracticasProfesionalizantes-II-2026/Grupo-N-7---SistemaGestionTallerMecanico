@model TallerMecanicoFront.Models.Persona
@using TallerMecanicoFront.Models
@{
    ViewData["Title"] = "Editar Persona";
    var localidades = ViewBag.Localidades as IEnumerable<Localidad> ?? Enumerable.Empty<Localidad>();
    var roles = ViewBag.Roles as IEnumerable<Rol> ?? Enumerable.Empty<Rol>();
}

<div class="row justify-content-center">
    <div class="col-12 col-xl-9">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h1 class="h4 mb-4">Editar Persona</h1>
                <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                    <input asp-for="Id" type="hidden" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label asp-for="TipoPersona" class="form-label">Tipo de persona</label>
                            <select asp-for="TipoPersona" class="form-select" id="tipoPersona" required>
                                <option value="Cliente">Cliente</option>
                                <option value="Proveedor">Proveedor</option>
                                <option value="Usuario">Usuario</option>
                            </select>
                            <span asp-validation-for="TipoPersona" class="text-danger"></span>
                        </div>
                        <div class="col-md-4"><label asp-for="Nombre" class="form-label"></label><input asp-for="Nombre" class="form-control" maxlength="100" required /><span asp-validation-for="Nombre" class="text-danger"></span></div>
                        <div class="col-md-4"><label asp-for="Apellido" class="form-label"></label><input asp-for="Apellido" class="form-control" maxlength="100" required /><span asp-validation-for="Apellido" class="text-danger"></span></div>
                        <div class="col-md-8"><label asp-for="Domicilio" class="form-label"></label><input asp-for="Domicilio" class="form-control" maxlength="200" required /><span asp-validation-for="Domicilio" class="text-danger"></span></div>
                        <div class="col-md-4">
                            <label asp-for="IdLocalidad" class="form-label">Localidad</label>
                            <select asp-for="IdLocalidad" class="form-select" required><option value="">Seleccione una localidad</option>@foreach (var localidad in localidades){<option value="@localidad.Id">@localidad.Nombre - @localidad.Provincia</option>}</select>
                            <span asp-validation-for="IdLocalidad" class="text-danger"></span>
                        </div>
                        <div class="col-md-6"><label asp-for="Telefono" class="form-label"></label><input asp-for="Telefono" class="form-control" maxlength="20" /></div>
                        <div class="col-md-6"><label asp-for="Correo" class="form-label"></label><input asp-for="Correo" type="email" class="form-control" maxlength="100" required /><span asp-validation-for="Correo" class="text-danger"></span></div>
                        <div class="col-md-6 campos-cuil"><label asp-for="CuilCuit" class="form-label">CUIL/CUIT</label><input asp-for="CuilCuit" class="form-control" maxlength="15" /><span asp-validation-for="CuilCuit" class="text-danger"></span></div>
                        <div class="col-md-6 campos-cuil"><label asp-for="CondFiscal" class="form-label">Condicion Fiscal</label><input asp-for="CondFiscal" class="form-control" maxlength="50" /><span asp-validation-for="CondFiscal" class="text-danger"></span></div>
                        <div class="col-md-6 campos-usuario"><label asp-for="Dni" class="form-label">DNI</label><input asp-for="Dni" class="form-control" maxlength="15" /><span asp-validation-for="Dni" class="text-danger"></span></div>
                        <div class="col-md-6 campos-usuario"><label asp-for="FechaNacimiento" class="form-label">Fecha de Nacimiento</label><input asp-for="FechaNacimiento" type="date" class="form-control" /></div>
                        <div class="col-md-6 campos-usuario"><label asp-for="IdRol" class="form-label">Rol</label><select asp-for="IdRol" class="form-select"><option value="">Seleccione un rol</option>@foreach (var rol in roles){<option value="@rol.Id">@rol.Nombre</option>}</select><span asp-validation-for="IdRol" class="text-danger"></span></div>
                        <div class="col-md-6 campos-usuario"><label asp-for="ContraseñaHash" class="form-label">Contraseña</label><input asp-for="ContraseñaHash" type="password" class="form-control" minlength="5" maxlength="255" /><span asp-validation-for="ContraseñaHash" class="text-danger"></span></div>
                    </div>
                    <div class="form-check mt-4 mb-4"><input asp-for="Activo" class="form-check-input" /><label asp-for="Activo" class="form-check-label">Persona activa</label></div>
                    <div class="d-flex gap-2"><button type="submit" class="btn btn-primary">Guardar Cambios</button><a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a></div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function actualizarCampos() {
            const tipo = document.getElementById('tipoPersona').value;
            document.querySelectorAll('.campos-cuil').forEach(elemento => elemento.hidden = tipo === 'Usuario');
            document.querySelectorAll('.campos-usuario').forEach(elemento => elemento.hidden = tipo !== 'Usuario');
        }
        document.getElementById('tipoPersona').addEventListener('change', actualizarCampos);
        actualizarCampos();
    </script>
}
