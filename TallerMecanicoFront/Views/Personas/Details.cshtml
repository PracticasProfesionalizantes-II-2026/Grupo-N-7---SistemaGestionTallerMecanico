@model TallerMecanicoFront.Models.Persona
@{
    ViewData["Title"] = "Detalle de la Persona";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Detalle de la Persona</h1>
    <span class="badge @(Model.Activo ? "bg-success" : "bg-secondary")">@(Model.Activo ? "Activo" : "Dado de baja")</span>
</div>

<dl class="row">
    <dt class="col-sm-3">Tipo</dt>
    <dd class="col-sm-9">@Model.TipoPersona</dd>

    <dt class="col-sm-3">Nombre</dt>
    <dd class="col-sm-9">@Model.Nombre</dd>

    <dt class="col-sm-3">Apellido</dt>
    <dd class="col-sm-9">@Model.Apellido</dd>

    <dt class="col-sm-3">Domicilio</dt>
    <dd class="col-sm-9">@Model.Domicilio</dd>

    <dt class="col-sm-3">Localidad (Id)</dt>
    <dd class="col-sm-9">@Model.IdLocalidad</dd>

    <dt class="col-sm-3">Teléfono</dt>
    <dd class="col-sm-9">@(Model.Telefono ?? "—")</dd>

    <dt class="col-sm-3">Correo</dt>
    <dd class="col-sm-9">@Model.Correo</dd>

    @if (!string.IsNullOrWhiteSpace(Model.CuilCuit))
    {
        <dt class="col-sm-3">CUIL/CUIT</dt>
        <dd class="col-sm-9">@Model.CuilCuit</dd>
    }
    @if (!string.IsNullOrWhiteSpace(Model.CondFiscal))
    {
        <dt class="col-sm-3">Condición fiscal</dt>
        <dd class="col-sm-9">@Model.CondFiscal</dd>
    }
    @if (!string.IsNullOrWhiteSpace(Model.Dni))
    {
        <dt class="col-sm-3">DNI</dt>
        <dd class="col-sm-9">@Model.Dni</dd>
    }
</dl>

<a asp-action="Index" class="btn btn-secondary">Volver</a>
