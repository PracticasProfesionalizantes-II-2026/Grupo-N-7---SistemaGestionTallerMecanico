@model IEnumerable<TallerMecanicoFront.Models.DetalleFacturaCompra>
@{
    ViewData["Title"] = "Detalles de Facturas de Compra";
    var facturaCompraId = ViewBag.FacturaCompraId as int?;
    var facturaPagada = Convert.ToBoolean(ViewBag.FacturaPagada ?? false);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Detalles de Facturas de Compra</h1>
    <div class="d-flex gap-2">
        @if (facturaCompraId.HasValue && !facturaPagada)
        {
            <a asp-action="Create" asp-route-facturaId="@facturaCompraId.GetValueOrDefault()" class="btn btn-primary">Nuevo Detalle</a>
        }
        <a asp-controller="FacturasCompras" asp-action="Index" class="btn btn-outline-secondary">Volver a facturas</a>
    </div>
</div>

@if (TempData["Error"] is not null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (!ViewData.ModelState.IsValid)
{
    <div asp-validation-summary="All" class="alert alert-danger"></div>
}

@if (facturaPagada)
{
    <div class="alert alert-info">La factura está pagada. Sus conceptos no se pueden editar ni eliminar.</div>
}

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Id</th>
                <th>Factura</th>
                <th>Insumo</th>
                <th>Fecha</th>
                <th>Cantidad</th>
                <th>Precio unitario</th>
                <th>Total</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.IdFacturaCompra</td>
                        <td>@item.IdInsumo</td>
                        <td>@item.FechaCompra.ToString("dd/MM/yyyy")</td>
                        <td>@item.Cantidad</td>
                        <td>@item.PrecioUnitario.ToString("N2")</td>
                        <td>@item.TotalCompra.ToString("N2")</td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-2">
                                @if (!facturaPagada)
                                {
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('¿Seguro que deseas eliminar este detalle?');">Eliminar</button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="8" class="text-center text-muted py-4">No hay detalles de facturas de compra registrados.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
