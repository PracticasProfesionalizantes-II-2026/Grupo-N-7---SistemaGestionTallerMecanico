@model TallerMecanicoFront.Models.DetalleFacturaCompra
@using TallerMecanicoFront.Models
@{
    ViewData["Title"] = "Editar Detalle de Factura de Compra";
    var facturas = ViewBag.FacturasCompras as IEnumerable<FacturaCompra> ?? Enumerable.Empty<FacturaCompra>();
    var insumos = ViewBag.Insumos as IEnumerable<Insumo> ?? Enumerable.Empty<Insumo>();
}

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h1 class="h4 mb-4">Editar Detalle de Factura de Compra</h1>

                <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="needs-validation" novalidate>
                    <input asp-for="Id" type="hidden" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="IdFacturaCompra" class="form-label">Factura de compra</label>
                        <select asp-for="IdFacturaCompra" class="form-select" required>
                            <option value="">Seleccione una factura</option>
                            @foreach (var factura in facturas)
                            {
                                <option value="@factura.Id">Factura N° @factura.Id - Proveedor @factura.IdProveedor - @factura.FechaFactura.ToString("dd/MM/yyyy") - Total $@factura.TotalFactura.ToString("0.00")</option>
                            }
                        </select>
                        <span asp-validation-for="IdFacturaCompra" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="IdInsumo" class="form-label">Insumo</label>
                        <select asp-for="IdInsumo" class="form-select" required>
                            <option value="">Seleccione un insumo</option>
                            @foreach (var insumo in insumos)
                            {
                                <option value="@insumo.Id" data-precio="@insumo.PrecioCompra.ToString(System.Globalization.CultureInfo.InvariantCulture)">@insumo.Nombre - Marca: @insumo.Marca - Stock: @insumo.Stock</option>
                            }
                        </select>
                        <span asp-validation-for="IdInsumo" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="FechaCompra" class="form-label"></label>
                        <input asp-for="FechaCompra" class="form-control" type="date" required />
                        <span asp-validation-for="FechaCompra" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Cantidad" class="form-label"></label>
                        <input asp-for="Cantidad" class="form-control" min="1" required />
                        <span asp-validation-for="Cantidad" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="PrecioUnitario" class="form-label"></label>
                        <input id="PrecioUnitario" name="PrecioUnitario" value="@Model.PrecioUnitario.ToString(System.Globalization.CultureInfo.InvariantCulture)" class="form-control" min="0" step="0.01" required />
                        <span asp-validation-for="PrecioUnitario" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="TotalCompra" class="form-label"></label>
                        <input id="TotalCompra" name="TotalCompra" value="@Model.TotalCompra.ToString(System.Globalization.CultureInfo.InvariantCulture)" type="number" step="0.01" class="form-control" readonly required />
                        <span asp-validation-for="TotalCompra" class="text-danger"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Guardar Cambios</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            'use strict';
            const forms = document.querySelectorAll('.needs-validation');
            Array.from(forms).forEach(form => {
                form.addEventListener('submit', event => {
                    if (!form.checkValidity()) {
                        event.preventDefault();
                        event.stopPropagation();
                    }
                    form.classList.add('was-validated');
                }, false);
            });
        })();

        document.addEventListener('DOMContentLoaded', function () {
            const form = document.querySelector('form');
            if (!form) return;

            const cantidadInput = form.querySelector('input[name="Cantidad"]');
            const precioInput = form.querySelector('input[name="PrecioUnitario"]');
            const totalInput = form.querySelector('input[name="TotalCompra"]');
            const insumoInput = form.querySelector('select[name="IdInsumo"]');

            if (!cantidadInput || !precioInput || !totalInput || !insumoInput) return;

            const calcularTotal = () => {
                const cantidad = Number.parseFloat(cantidadInput.value) || 0;
                const precio = Number.parseFloat(precioInput.value) || 0;
                const total = Math.round((cantidad * precio + Number.EPSILON) * 100) / 100;
                totalInput.value = total.toFixed(2);
            };

            cantidadInput.addEventListener('input', calcularTotal);
            precioInput.addEventListener('input', calcularTotal);
            insumoInput.addEventListener('change', () => {
                const opcion = insumoInput.options[insumoInput.selectedIndex];
                if (opcion?.dataset.precio) {
                    precioInput.value = opcion.dataset.precio;
                    calcularTotal();
                }
            });
            calcularTotal();
        });
    </script>
}
