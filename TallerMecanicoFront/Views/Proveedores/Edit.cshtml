@model TallerMecanicoFront.Models.Proveedor
@using TallerMecanicoFront.Models
@{
    ViewData["Title"] = "Editar Proveedor";
    var localidades = ViewBag.Localidades as IEnumerable<Localidad> ?? Enumerable.Empty<Localidad>();
}

<div class="row justify-content-center">
    <div class="col-12 col-xl-9">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h1 class="h4 mb-4">Editar Proveedor</h1>

                <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="needs-validation" novalidate>
                    <input asp-for="Id" type="hidden" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Nombre" class="form-label"></label>
                            <input asp-for="Nombre" class="form-control" maxlength="100" required />
                            <span asp-validation-for="Nombre" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Apellido" class="form-label"></label>
                            <input asp-for="Apellido" class="form-control" maxlength="100" required />
                            <span asp-validation-for="Apellido" class="text-danger"></span>
                        </div>
                        <div class="col-md-8">
                            <label asp-for="Domicilio" class="form-label"></label>
                            <input asp-for="Domicilio" class="form-control" maxlength="200" required />
                            <span asp-validation-for="Domicilio" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="IdLocalidad" class="form-label">Localidad</label>
                            <select asp-for="IdLocalidad" class="form-select" required>
                                <option value="">Seleccione una localidad</option>
                                @foreach (var localidad in localidades)
                                {
                                    <option value="@localidad.Id">@localidad.Nombre - @localidad.Provincia</option>
                                }
                            </select>
                            <span asp-validation-for="IdLocalidad" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Telefono" class="form-label"></label>
                            <input asp-for="Telefono" class="form-control" maxlength="20" />
                            <span asp-validation-for="Telefono" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Correo" class="form-label"></label>
                            <input asp-for="Correo" type="email" class="form-control" maxlength="100" required />
                            <span asp-validation-for="Correo" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="CuilCuit" class="form-label">CUIL/CUIT</label>
                            <input asp-for="CuilCuit" class="form-control" minlength="11" maxlength="15" required />
                            <span asp-validation-for="CuilCuit" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="CondFiscal" class="form-label">Condición fiscal</label>
                            <input asp-for="CondFiscal" class="form-control" maxlength="50" required />
                            <span asp-validation-for="CondFiscal" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="form-check mt-4 mb-4">
                        <input asp-for="Activo" class="form-check-input" />
                        <label asp-for="Activo" class="form-check-label">Proveedor activo</label>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Guardar Cambios</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
