@model IEnumerable<TallerMecanicoFront.Models.Proveedor>
@{
    ViewData["Title"] = "Proveedores";
    var estadoActual = (ViewBag.Estado as string) ?? "activos";
    var busquedaActual = (ViewBag.Buscar as string) ?? string.Empty;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Proveedores</h1>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-person-fill-add"></i> Nuevo Proveedor</a>
</div>

@if (TempData["Exito"] is not null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Exito"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

@if (TempData["Error"] is not null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-octagon-fill"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

@if (!ViewData.ModelState.IsValid)
{
    <div asp-validation-summary="All" class="alert alert-danger"></div>
}

<form method="get" asp-action="Index" class="row row-cols-auto g-3 align-items-end mb-4">
    <div class="col">
        <label class="form-label fw-semibold">Buscar</label>
        <div class="input-group">
            <span class="input-group-text bg-white text-muted"><i class="bi bi-search"></i></span>
            <input type="text"
                   name="buscar"
                   class="form-control"
                   placeholder="Nombre, apellido, CUIL/CUIT o correo..."
                   value="@busquedaActual" />
        </div>
    </div>
    <div class="col">
        <label class="form-label fw-semibold">Estado</label>
        <select name="estado" class="form-select">
            <!option value="activos" @(estadoActual == "activos" ? "selected" : "")>Solo activos</!option>
            <!option value="todos" @(estadoActual == "todos" ? "selected" : "")>Todos</!option>
            <!option value="inactivos" @(estadoActual == "inactivos" ? "selected" : "")>Solo dados de baja</!option>
        </select>
    </div>
    <div class="col">
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-search"></i> Buscar
        </button>
        @if (!string.IsNullOrWhiteSpace(busquedaActual) || estadoActual != "activos")
        {
            <a asp-action="Index" class="btn btn-outline-secondary ms-1">
                <i class="bi bi-x-circle"></i> Limpiar
            </a>
        }
    </div>
</form>

<div class="table-responsive tabla-scroll">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Id</th>
                <th>Proveedor</th>
                <th>CUIL/CUIT</th>
                <th>Correo</th>
                <th>Estado</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.Apellido, @item.Nombre</td>
                        <td>@item.CuilCuit</td>
                        <td>@item.Correo</td>
                        <td>
                            @if (item.Activo)
                            {
                                <span class="badge text-bg-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">Inactivo</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-2">
                                @if (item.Activo)
                                {
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                                    <button type="button" class="btn btn-sm btn-outline-danger"
                                            data-confirmar-baja
                                            data-baja-url="@Url.Action("Delete", new { id = item.Id })"
                                            data-pendientes-url="@Url.Action("Verificar", "Bajas", new { entidad = "persona", id = item.Id })"
                                            data-nombre="@($"{item.Apellido}, {item.Nombre}")"
                                            data-reactivable="false">
                                        Dar de baja
                                    </button>
                                }
                                else
                                {
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Ver detalle</a>
                                }
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-center text-muted py-4">
                        @if (!string.IsNullOrWhiteSpace(busquedaActual) || estadoActual != "activos")
                        {
                            <span>No se encontraron proveedores con los filtros seleccionados.</span>
                        }
                        else
                        {
                            <span>No hay proveedores registrados.</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<partial name="_ConfirmarBajaModal" />
