@model TallerMecanicoFront.Models.Trabajo
@using TallerMecanicoFront.Models
@{
    ViewData["Title"] = "Crear Trabajo";
    var categorias = ViewBag.CategoriasTrabajos as IEnumerable<CategoriaTrabajo> ?? Enumerable.Empty<CategoriaTrabajo>();
}

<div class="row justify-content-center">
    <div class="col-12 col-xl-9">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h1 class="h4 mb-4">Nuevo Trabajo</h1>
                <form asp-action="Create" method="post">
                    <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="IdCategoria" class="form-label">Categoría</label>
                            <div class="input-group">
                                <select asp-for="IdCategoria" class="form-select" required>
                                    <option value="">Seleccione una categoría</option>
                                    @foreach (var categoria in categorias)
                                    {
                                        <option value="@categoria.Id">@categoria.Categoria</option>
                                    }
                                </select>
                                <a asp-controller="CategoriasTrabajos" asp-action="Create" asp-route-returnUrl="@Context.Request.Path" class="btn btn-outline-secondary" title="Agregar categoría">Nueva</a>
                            </div>
                            <span asp-validation-for="IdCategoria" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Nombre" class="form-label"></label>
                            <input asp-for="Nombre" class="form-control" maxlength="100" required />
                            <span asp-validation-for="Nombre" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PrecioHsManoObra" class="form-label">Precio hora</label>
                            <input asp-for="PrecioHsManoObra" type="number" step="0.01" min="0" class="form-control" required />
                            <span asp-validation-for="PrecioHsManoObra" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 d-flex align-items-end">
                            <div class="form-check mt-4">
                                <input type="hidden" asp-for="Activo" value="true" />
                            </div>
                        </div>
                        <div class="col-12">
                            <label asp-for="Descripcion" class="form-label"></label>
                            <textarea asp-for="Descripcion" class="form-control" rows="3" required></textarea>
                            <span asp-validation-for="Descripcion" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary">Guardar</button>
                        @if (ViewData["ReturnUrl"] is string returnUrl)
                        {
                            <a href="@returnUrl" class="btn btn-outline-secondary">Cancelar</a>
                        }
                        else
                        {
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                        }
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
