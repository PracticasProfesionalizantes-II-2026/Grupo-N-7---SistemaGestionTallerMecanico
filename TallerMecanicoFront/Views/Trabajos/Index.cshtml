@model IEnumerable<TallerMecanicoFront.Models.Trabajo>
@{
    ViewData["Title"] = "Trabajos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Trabajos</h1>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle-fill"></i> Nuevo Trabajo</a>
</div>

@if (TempData["Error"] is not null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-octagon-fill"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

<div class="table-responsive tabla-scroll">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Id</th>
                <th>Categoría</th>
                <th>Nombre</th>
                <th>Descripción</th>
                <th>Precio</th>
                <th>Activo</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.IdCategoria</td>
                        <td>@item.Nombre</td>
                        <td>@item.Descripcion</td>
                        <td>$@item.PrecioHsManoObra.ToString("0.00")</td>
                        <td>@(item.Activo ? "Sí" : "No")</td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-2">
                                @if (item.Activo)
                                {
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                                    <button type="button" class="btn btn-sm btn-outline-danger"
                                            data-confirmar-baja
                                            data-baja-url="@Url.Action("Delete", new { id = item.Id })"
                                            data-pendientes-url="@Url.Action("Verificar", "Bajas", new { entidad = "trabajo", id = item.Id })"
                                            data-nombre="@item.Nombre"
                                            data-reactivable="false">
                                        Dar de baja
                                    </button>
                                }
                                else
                                {
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Ver detalle</a>
                                }
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" class="text-center text-muted py-4">No hay trabajos registrados.</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<partial name="_ConfirmarBajaModal" />
