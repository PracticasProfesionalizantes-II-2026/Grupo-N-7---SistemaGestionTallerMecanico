@model TallerMecanicoFront.Models.Trabajo
@{
    ViewData["Title"] = "Detalle del Trabajo";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Detalle del Trabajo</h1>
    <span class="badge @(Model.Activo ? "bg-success" : "bg-secondary")">@(Model.Activo ? "Activo" : "Dado de baja")</span>
</div>

<dl class="row">
    <dt class="col-sm-3">Nombre</dt>
    <dd class="col-sm-9">@Model.Nombre</dd>

    <dt class="col-sm-3">Categoría (Id)</dt>
    <dd class="col-sm-9">@Model.IdCategoria</dd>

    <dt class="col-sm-3">Descripción</dt>
    <dd class="col-sm-9">@Model.Descripcion</dd>

    <dt class="col-sm-3">Precio hora de mano de obra</dt>
    <dd class="col-sm-9">$@Model.PrecioHsManoObra.ToString("0.00")</dd>
</dl>

<a asp-action="Index" class="btn btn-secondary">Volver</a>
