@model IEnumerable<TallerMecanicoFront.Models.Insumo>
@{
    ViewData["Title"] = "Insumos";
    var estadoActual = (ViewBag.Estado as string) ?? "activos";
    var busquedaActual = (ViewBag.Buscar as string) ?? string.Empty;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Insumos</h1>
    <a asp-action="Create" class="btn btn-primary">Nuevo Insumo</a>
</div>

@if (TempData["Error"] is not null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<form method="get" asp-action="Index" class="row row-cols-auto g-3 align-items-end mb-4">
    <div class="col">
        <label class="form-label fw-semibold">Buscar</label>
        <div class="input-group">
            <span class="input-group-text bg-white text-muted"><i class="bi bi-search"></i></span>
            <input type="text"
                   name="buscar"
                   class="form-control"
                   placeholder="Nombre o marca..."
                   value="@busquedaActual" />
        </div>
    </div>
    <div class="col">
        <label class="form-label fw-semibold">Estado</label>
        <select name="estado" class="form-select">
            <!option value="activos" @(estadoActual == "activos" ? "selected" : "")>Solo activos</!option>
            <!option value="todos" @(estadoActual == "todos" ? "selected" : "")>Todos</!option>
            <!option value="inactivos" @(estadoActual == "inactivos" ? "selected" : "")>Solo dados de baja</!option>
        </select>
    </div>
    <div class="col">
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-search"></i> Buscar
        </button>
        @if (!string.IsNullOrWhiteSpace(busquedaActual) || estadoActual != "activos")
        {
            <a asp-action="Index" class="btn btn-outline-secondary ms-1">
                <i class="bi bi-x-circle"></i> Limpiar
            </a>
        }
    </div>
</form>

<div class="table-responsive tabla-scroll">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Id</th>
                <th>Nombre</th>
                <th>Marca</th>
                <th>Proveedor</th>
                <th>Stock</th>
                <th>Precio compra</th>
                <th>Precio venta</th>
                <th>Estado</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.Nombre</td>
                        <td>@item.Marca</td>
                        <td>@item.IdProveedor</td>
                        <td>@item.Stock</td>
                        <td>$@item.PrecioCompra.ToString("0.00")</td>
                        <td>$@item.PrecioVenta.ToString("0.00")</td>
                        <td>
                            @if (item.Activo)
                            {
                                <span class="badge text-bg-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">Inactivo</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-2">
                                @if (item.Activo)
                                {
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('¿Dar de baja este insumo? Vas a poder seguir viendo su detalle, pero no editarlo.');">Dar de baja</button>
                                    </form>
                                }
                                else
                                {
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Ver detalle</a>
                                }
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="9" class="text-center text-muted py-4">
                        @if (!string.IsNullOrWhiteSpace(busquedaActual) || estadoActual != "activos")
                        {
                            <span>No se encontraron insumos con los filtros seleccionados.</span>
                        }
                        else
                        {
                            <span>No hay insumos registrados.</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
