@model TallerMecanicoFront.Models.Insumo
@using TallerMecanicoFront.Models
@{
    ViewData["Title"] = "Crear Insumo";
    var proveedores = ViewBag.Proveedores as IEnumerable<Proveedor> ?? Enumerable.Empty<Proveedor>();
    var facturaCompraId = ViewBag.FacturaCompraId as int?;
}

<div class="row justify-content-center">
    <div class="col-12 col-xl-9">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h1 class="h4 mb-4">Nuevo Insumo</h1>
                <form asp-action="Create" method="post">
                    <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
                    @if (facturaCompraId.HasValue)
                    {
                        <input type="hidden" name="facturaId" value="@facturaCompraId.Value" />
                    }
                    <input asp-for="Stock" type="hidden" />
                    <input asp-for="PrecioCompra" type="hidden" value="0" />
                    <input asp-for="PrecioVenta" type="hidden" value="0" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Nombre" class="form-label"></label>
                            <input asp-for="Nombre" class="form-control" maxlength="100" required />
                            <span asp-validation-for="Nombre" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Marca" class="form-label"></label>
                            <input asp-for="Marca" class="form-control" maxlength="50" required />
                            <span asp-validation-for="Marca" class="text-danger"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Descripcion" class="form-label"></label>
                            <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Descripcion" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="IdProveedor" class="form-label">Proveedor</label>
                            <div class="input-group">
                                <select asp-for="IdProveedor" class="form-select" required>
                                    <option value="">Seleccione un proveedor</option>
                                    @foreach (var proveedor in proveedores)
                                    {
                                        <option value="@proveedor.Id">@proveedor.Apellido, @proveedor.Nombre</option>
                                    }
                                </select>
                                <a asp-controller="Proveedores" asp-action="Create" asp-route-returnUrl="@Context.Request.Path@Context.Request.QueryString" class="btn btn-outline-secondary" title="Agregar proveedor">Nuevo</a>
                            </div>
                            <span asp-validation-for="IdProveedor" class="text-danger"></span>
                        </div>
                        <div class="col-md-3 d-flex align-items-end">
                            <div class="form-check mt-4">
                                <input type="hidden" asp-for="Activo" value="true" />
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-center gap-5 mt-5">
                        <button type="submit" class="btn btn-success">Guardar</button>
                        <a asp-action="Index" class="btn btn-danger">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
