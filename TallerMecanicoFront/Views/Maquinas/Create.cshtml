@model TallerMecanicoFront.Models.Maquina
@using TallerMecanicoFront.Models
@{
    ViewData["Title"] = "Crear Máquina";
    var clientes = ViewBag.Clientes as IEnumerable<Cliente> ?? Enumerable.Empty<Cliente>();
}

<div class="row justify-content-center">
    <div class="col-12 col-xl-9">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h1 class="h4 mb-4">Nueva Máquina</h1>

                <form asp-action="Create" method="post">
                    <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Nombre" class="form-label"></label>
                            <input asp-for="Nombre" class="form-control" maxlength="100" required />
                            <span asp-validation-for="Nombre" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Marca" class="form-label"></label>
                            <input asp-for="Marca" class="form-control" maxlength="50" required />
                            <span asp-validation-for="Marca" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Motor" class="form-label"></label>
                            <input asp-for="Motor" class="form-control" maxlength="100" required />
                            <span asp-validation-for="Motor" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Patente" class="form-label"></label>
                            <input asp-for="Patente" class="form-control" maxlength="10" required />
                            <span asp-validation-for="Patente" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="IdCliente" class="form-label">Cliente</label>
                            <div class="input-group">
                                <select asp-for="IdCliente" class="form-select" required>
                                    <option value="">Seleccione un cliente</option>
                                    @foreach (var cliente in clientes)
                                    {
                                        <option value="@cliente.Id">@cliente.Apellido, @cliente.Nombre</option>
                                    }
                                </select>
                                <a asp-controller="Clientes" asp-action="Create" asp-route-returnUrl="@Context.Request.Path" class="btn btn-outline-secondary" title="Agregar cliente">Nuevo</a>
                            </div>
                            <span asp-validation-for="IdCliente" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 d-flex align-items-end">
                            <div class="form-check mt-4">
                                <input type="hidden" asp-for="Activo" value="true" />
                            </div>
                        </div>
                    </div>


                    <div class="d-flex justify-content-center gap-5 mt-5">
                        <button type="submit" class="btn btn-success">Guardar</button>
                        @if (ViewData["ReturnUrl"] is string returnUrl)
                        {
                            <a href="@returnUrl" class="btn btn-danger">Cancelar</a>
                        }
                        else
                        {
                            <a asp-action="Index" class="btn btn-danger">Cancelar</a>
                        }
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
