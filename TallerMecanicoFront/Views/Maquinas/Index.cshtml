@model IEnumerable<TallerMecanicoFront.Models.Maquina>
@{
    ViewData["Title"] = "Máquinas";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Máquinas</h1>
    <a asp-action="Create" class="btn btn-primary">Nueva Máquina</a>
</div>

@if (TempData["Error"] is not null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (!ViewData.ModelState.IsValid)
{
    <div asp-validation-summary="All" class="alert alert-danger"></div>
}

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Id</th>
                <th>Nombre</th>
                <th>Marca</th>
                <th>Motor</th>
                <th>Patente</th>
                <th>Cliente</th>
                <th>Activo</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.Nombre</td>
                        <td>@item.Marca</td>
                        <td>@item.Motor</td>
                        <td>@item.Patente</td>
                        <td>@item.IdCliente</td>
                        <td>@(item.Activo ? "Sí" : "No")</td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-2">
                                @if (item.Activo)
                                {
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('¿Dar de baja este máquina? Vas a poder seguir viendo su detalle, pero no editarlo.');">Dar de baja</button>
                                    </form>
                                }
                                else
                                {
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Ver detalle</a>
                                }
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="8" class="text-center text-muted py-4">No hay máquinas registradas.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
