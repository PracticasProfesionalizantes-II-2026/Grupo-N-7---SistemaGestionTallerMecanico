@model TallerMecanicoFront.Models.Maquina
@{
    ViewData["Title"] = "Detalle de la Máquina";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Detalle de la Máquina</h1>
    <span class="badge @(Model.Activo ? "bg-success" : "bg-secondary")">@(Model.Activo ? "Activo" : "Dado de baja")</span>
</div>

<dl class="row">
    <dt class="col-sm-3">Nombre</dt>
    <dd class="col-sm-9">@Model.Nombre</dd>

    <dt class="col-sm-3">Marca</dt>
    <dd class="col-sm-9">@Model.Marca</dd>

    <dt class="col-sm-3">Motor</dt>
    <dd class="col-sm-9">@Model.Motor</dd>

    <dt class="col-sm-3">Patente</dt>
    <dd class="col-sm-9">@Model.Patente</dd>

    <dt class="col-sm-3">Cliente (Id)</dt>
    <dd class="col-sm-9">@Model.IdCliente</dd>
</dl>

<a asp-action="Index" class="btn btn-secondary">Volver</a>
