@model TallerMecanicoFront.Models.SesionCaja
@using TallerMecanicoFront.Models
@{
    ViewData["Title"] = "Crear Sesión de Caja";
    var usuarios = ViewBag.Usuarios as IEnumerable<Usuario> ?? Enumerable.Empty<Usuario>();
}

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h1 class="h4 mb-4">Nueva Sesión de Caja</h1>

                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="IdUsuario" class="form-label">Usuario</label>
                        <select asp-for="IdUsuario" class="form-select" required>
                            <option value="">Seleccione un usuario</option>
                            @foreach (var usuario in usuarios)
                            {
                                <option value="@usuario.Id">@usuario.Apellido, @usuario.Nombre</option>
                            }
                        </select>
                        <span asp-validation-for="IdUsuario" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="FechaInicio" class="form-label">Fecha de inicio</label>
                        <input asp-for="FechaInicio" type="datetime-local" class="form-control" required />
                        <span asp-validation-for="FechaInicio" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="FechaFin" class="form-label">Fecha de fin</label>
                        <input asp-for="FechaFin" type="datetime-local" class="form-control" required />
                        <span asp-validation-for="FechaFin" class="text-danger"></span>
                    </div>

                    <div class="form-check mb-4">
                        <input asp-for="Vigente" class="form-check-input" />
                        <label asp-for="Vigente" class="form-check-label">Sesión vigente</label>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Guardar</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
