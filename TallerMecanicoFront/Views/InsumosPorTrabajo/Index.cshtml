@model IEnumerable<TallerMecanicoFront.Models.InsumoPorTrabajo>
@{
    ViewData["Title"] = "Insumos por Trabajo";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Insumos por Trabajo</h1>
    <a asp-action="Create" class="btn btn-primary">Nuevo Insumo por Trabajo</a>
</div>

@if (TempData["Error"] is not null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Id</th>
                <th>Trabajo por Turno</th>
                <th>Insumo</th>
                <th>Costo</th>
                <th>Cantidad</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.IdTrabajoTurno</td>
                        <td>@item.IdInsumo</td>
                        <td>$@item.CostoInsumo.ToString("0.00")</td>
                        <td>@item.Cantidad</td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-2">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('¿Seguro que deseas eliminar este insumo por trabajo?');">Eliminar</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-center text-muted py-4">No hay insumos por trabajo registrados.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
