@model TallerMecanicoFront.Models.InsumoPorTrabajo
@using TallerMecanicoFront.Models
@{
    ViewData["Title"] = "Editar Insumo por Trabajo";
    var trabajos = ViewBag.TrabajosPorTurno as IEnumerable<TrabajoPorTurno> ?? Enumerable.Empty<TrabajoPorTurno>();
    var insumos = ViewBag.Insumos as IEnumerable<Insumo> ?? Enumerable.Empty<Insumo>();
}

<div class="row justify-content-center">
    <div class="col-12 col-xl-9">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h1 class="h4 mb-4">Editar Insumo por Trabajo</h1>
                <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                    <input asp-for="Id" type="hidden" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="IdTrabajoTurno" class="form-label">Trabajo por turno</label>
                            <select asp-for="IdTrabajoTurno" class="form-select" required>
                                <option value="">Seleccione un trabajo por turno</option>
                                @foreach (var trabajo in trabajos)
                                {
                                    <option value="@trabajo.Id">Trabajo N° @trabajo.Id - Turno @trabajo.IdTurno</option>
                                }
                            </select>
                            <span asp-validation-for="IdTrabajoTurno" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="IdInsumo" class="form-label">Insumo</label>
                            <select asp-for="IdInsumo" class="form-select" required>
                                <option value="">Seleccione un insumo</option>
                                @foreach (var insumo in insumos)
                                {
                                    <option value="@insumo.Id">@insumo.Nombre - @insumo.Marca</option>
                                }
                            </select>
                            <span asp-validation-for="IdInsumo" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="CostoInsumo" class="form-label">Costo</label>
                            <input asp-for="CostoInsumo" type="number" step="0.01" min="0" class="form-control" required />
                            <span asp-validation-for="CostoInsumo" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Cantidad" class="form-label"></label>
                            <input asp-for="Cantidad" type="number" min="1" class="form-control" required />
                            <span asp-validation-for="Cantidad" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary">Guardar cambios</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
