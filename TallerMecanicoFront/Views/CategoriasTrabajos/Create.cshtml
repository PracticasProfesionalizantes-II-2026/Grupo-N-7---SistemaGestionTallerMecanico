@model TallerMecanicoFront.Models.CategoriaTrabajo
@{
    ViewData["Title"] = "Crear Categoria de Trabajo";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h1 class="h4 mb-4">Nueva Categoria de Trabajo</h1>

                <form asp-action="Create" method="post" class="needs-validation" novalidate>
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Categoria" class="form-label"></label>
                        <input asp-for="Categoria" class="form-control" maxlength="100" required />
                        <span asp-validation-for="Categoria" class="text-danger"></span>
                        <div class="invalid-feedback">Ingresa el nombre de la categoria.</div>
                    </div>

                    <div class="form-check mb-4">
                        <input type="hidden" asp-for="Activo" value="true" />
                    </div>

                    <div class="d-flex justify-content-center gap-5 mt-5">
                        <button type="submit" class="btn btn-success">Guardar</button>
                        <a asp-action="Index" class="btn btn-danger">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            'use strict';
            const forms = document.querySelectorAll('.needs-validation');
            Array.from(forms).forEach(form => {
                form.addEventListener('submit', event => {
                    if (!form.checkValidity()) {
                        event.preventDefault();
                        event.stopPropagation();
                    }
                    form.classList.add('was-validated');
                }, false);
            });
        })();
    </script>
}
