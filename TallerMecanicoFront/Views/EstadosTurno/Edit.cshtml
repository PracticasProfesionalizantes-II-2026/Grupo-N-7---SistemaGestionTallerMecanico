@model TallerMecanicoFront.Models.EstadoTurno
@{
    ViewData["Title"] = "Editar Estado de Turno";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h1 class="h4 mb-4">Editar Estado de Turno</h1>

                <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="needs-validation" novalidate>
                    <input asp-for="Id" type="hidden" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-4">
                        <label asp-for="Nombre" class="form-label"></label>
                        <input asp-for="Nombre" class="form-control" maxlength="25" required />
                        <span asp-validation-for="Nombre" class="text-danger"></span>
                        <div class="invalid-feedback">Ingresa el nombre del estado.</div>
                    </div>

                    <div class="d-flex justify-content-center gap-5 mt-5">
                        <button type="submit" class="btn btn-success">Guardar Cambios</button>
                        <a asp-action="Index" class="btn btn-danger">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
