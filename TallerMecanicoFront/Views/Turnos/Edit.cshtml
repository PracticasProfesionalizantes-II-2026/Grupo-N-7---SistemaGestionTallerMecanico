@model TallerMecanicoFront.Models.Turno
@using TallerMecanicoFront.Models
@{
    ViewData["Title"] = "Editar Turno";
    var clientes = ViewBag.Clientes as IEnumerable<Cliente> ?? Enumerable.Empty<Cliente>();
    var maquinas = ViewBag.Maquinas as IEnumerable<Maquina> ?? Enumerable.Empty<Maquina>();
    var tiposTurno = ViewBag.TiposTurno as IEnumerable<TipoTurno> ?? Enumerable.Empty<TipoTurno>();
    var estadosTurno = ViewBag.EstadosTurno as IEnumerable<EstadoTurno> ?? Enumerable.Empty<EstadoTurno>();
}

<div class="row justify-content-center">
    <div class="col-12 col-xl-9">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h1 class="h4 mb-4">Editar Turno</h1>

                <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                    <input asp-for="Id" type="hidden" />
                    <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="IdCliente" class="form-label">Cliente</label>
                            <div class="input-group">
                                <select asp-for="IdCliente" class="form-select" id="selectCliente" required>
                                    <option value="">Seleccione un cliente</option>
                                    @foreach (var cliente in clientes)
                                    {
                                        <option value="@cliente.Id">@cliente.Apellido, @cliente.Nombre</option>
                                    }
                                </select>
                                <a asp-controller="Clientes" asp-action="Create" asp-route-returnUrl="@Context.Request.Path@Context.Request.QueryString" class="btn btn-outline-secondary" title="Agregar cliente">Nuevo</a>
                            </div>
                            <span asp-validation-for="IdCliente" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="IdMaquina" class="form-label">Máquina</label>
                            <div class="input-group">
                                <select asp-for="IdMaquina" class="form-select" id="selectMaquina" required>
                                    <option value="">Seleccione una máquina</option>
                                    @foreach (var maquina in maquinas)
                                    {
                                        <option value="@maquina.Id" data-cliente="@maquina.IdCliente">@maquina.Nombre - @maquina.Marca - @maquina.Patente</option>
                                    }
                                </select>
                                <a asp-controller="Maquinas" asp-action="Create" asp-route-returnUrl="@Context.Request.Path@Context.Request.QueryString" class="btn btn-outline-secondary" title="Agregar máquina">Nueva</a>
                            </div>
                            <span asp-validation-for="IdMaquina" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="IdTipoTurno" class="form-label">Tipo de turno</label>
                            <div class="input-group">
                                <select asp-for="IdTipoTurno" class="form-select">
                                    <option value="">Seleccione un tipo</option>
                                    @foreach (var tipo in tiposTurno)
                                    {
                                        <option value="@tipo.Id">@tipo.Nombre</option>
                                    }
                                </select>
                                <a asp-controller="TiposTurno" asp-action="Create" asp-route-returnUrl="@Context.Request.Path@Context.Request.QueryString" class="btn btn-outline-secondary" title="Agregar tipo de turno">Nuevo</a>
                            </div>
                            <span asp-validation-for="IdTipoTurno" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="IdEstado" class="form-label">Estado</label>
                            <div class="input-group">
                                <select asp-for="IdEstado" class="form-select">
                                    <option value="">Seleccione un estado</option>
                                    @foreach (var estado in estadosTurno)
                                    {
                                        <option value="@estado.Id">@estado.Nombre</option>
                                    }
                                </select>
                                <a asp-controller="EstadosTurno" asp-action="Create" asp-route-returnUrl="@Context.Request.Path@Context.Request.QueryString" class="btn btn-outline-secondary" title="Agregar estado de turno">Nuevo</a>
                            </div>
                            <span asp-validation-for="IdEstado" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Fecha" class="form-label">Fecha</label>
                            <input asp-for="Fecha" type="date" class="form-control" required />
                            <span asp-validation-for="Fecha" class="text-danger"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Descripcion" class="form-label">Descripción</label>
                            <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Descripcion" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary">Guardar cambios</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const selectCliente = document.getElementById('selectCliente');
            const selectMaquina = document.getElementById('selectMaquina');
            if (!selectCliente || !selectMaquina) return;

            const opciones = Array.from(selectMaquina.options).filter(o => o.value !== '');

            function filtrarMaquinas() {
                const idCliente = selectCliente.value;
                const valorPrevio = selectMaquina.value;

                selectMaquina.innerHTML = '';
                const placeholder = document.createElement('option');
                placeholder.value = '';
                placeholder.textContent = idCliente ? 'Seleccione una máquina' : 'Seleccione primero un cliente';
                selectMaquina.appendChild(placeholder);

                opciones
                    .filter(o => !idCliente || o.dataset.cliente === idCliente)
                    .forEach(o => selectMaquina.appendChild(o.cloneNode(true)));

                if (Array.from(selectMaquina.options).some(o => o.value === valorPrevio)) {
                    selectMaquina.value = valorPrevio;
                }
            }

            selectCliente.addEventListener('change', filtrarMaquinas);
            filtrarMaquinas();
        })();
    </script>
}
