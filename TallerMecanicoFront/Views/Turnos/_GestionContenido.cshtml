@model TallerMecanicoFront.Models.TurnoGestionViewModel
@{
    var bloqueado = !Model.PuedeEditar;
}

@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <div class="alert alert-danger">@Model.Error</div>
}

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="h5 mb-0">Detalle operativo</h2>
            @if (!bloqueado)
            {
                <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="collapse" data-bs-target="#formDetalle">
                    @(Model.Detalle is null ? "Agregar detalle" : "Editar detalle")
                </button>
            }
        </div>

        @if (Model.Detalle is null)
        {
            <p class="text-muted mb-0">Todavía no se cargó el domicilio ni la localidad del trabajo.</p>
        }
        else
        {
            <dl class="row mb-0">
                <dt class="col-sm-3">Domicilio</dt>
                <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Detalle.DomicilioTrabajo) ? "-" : Model.Detalle.DomicilioTrabajo)</dd>
                <dt class="col-sm-3">Localidad</dt>
                <dd class="col-sm-9">@(Model.Localidades.FirstOrDefault(l => l.Id == Model.Detalle.IdLocalidad)?.Nombre ?? "-")</dd>
            </dl>
        }

        @if (!bloqueado)
        {
            <div class="collapse mt-3" id="formDetalle">
                <form class="form-ajax-gestion border-top pt-3" method="post"
                      action="/DetallesTurnos/GuardarAjax" data-idturno="@Model.Turno.Id">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="Id" value="@(Model.Detalle?.Id ?? 0)" />
                    <input type="hidden" name="IdTurno" value="@Model.Turno.Id" />
                    <div class="row g-2">
                        <div class="col-md-6">
                            <label class="form-label">Domicilio</label>
                            <input type="text" name="DomicilioTrabajo" class="form-control" value="@Model.Detalle?.DomicilioTrabajo" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Localidad</label>
                            <select name="IdLocalidad" class="form-select">
                                <option value="">Seleccione una localidad</option>
                                @foreach (var localidad in Model.Localidades)
                                {
                                    <option value="@localidad.Id" selected="@(localidad.Id == Model.Detalle?.IdLocalidad)">@localidad.Nombre</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-2 d-flex align-items-end">
                            <button type="submit" class="btn btn-primary w-100">Guardar</button>
                        </div>
                    </div>
                </form>
            </div>
        }
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h5 mb-0">Mano de obra y materiales</h2>
</div>

@if (!Model.Trabajos.Any())
{
    <div class="alert alert-light border">No hay trabajos cargados para este turno.</div>
}
else
{
    foreach (var trabajo in Model.Trabajos)
    {
        <div class="card shadow-sm border-0 mb-3">
            <div class="card-body">
                <div class="table-responsive tabla-scroll">
                    <table class="table table-sm table-striped align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Trabajo</th>
                                <th>Usuario</th>
                                <th>Horas</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>@(string.IsNullOrWhiteSpace(trabajo.NombreTrabajo) ? $"Trabajo #{trabajo.IdTrabajo}" : trabajo.NombreTrabajo)</td>
                                <td>@(string.IsNullOrWhiteSpace(trabajo.NombreUsuario) ? $"Usuario #{trabajo.IdUsuario}" : trabajo.NombreUsuario)</td>
                                <td>@trabajo.HsHombre.ToString("0", System.Globalization.CultureInfo.InvariantCulture)</td>
                                <td class="text-end">
                                    @if (!bloqueado)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="collapse" data-bs-target="#formTrabajo-@trabajo.Id">Editar</button>
                                    }
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                @if (!bloqueado)
                {
                    <div class="collapse mt-3" id="formTrabajo-@trabajo.Id">
                        <form class="form-ajax-gestion border-top pt-3" method="post"
                              action="/TrabajosPorTurno/GuardarAjax" data-idturno="@Model.Turno.Id">
                    @Html.AntiForgeryToken()
                            <input type="hidden" name="Id" value="@trabajo.Id" />
                            <input type="hidden" name="IdTurno" value="@Model.Turno.Id" />
                            <div class="row g-2">
                                <div class="col-md-4">
                                    <label class="form-label">Trabajo</label>
                                    <select name="IdTrabajo" class="form-select">
                                        @foreach (var t in Model.TrabajosDisponibles)
                                        {
                                            <option value="@t.Id" selected="@(t.Id == trabajo.IdTrabajo)">@t.Nombre</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label">Usuario</label>
                                    <select name="IdUsuario" class="form-select">
                                        @foreach (var u in Model.UsuariosDisponibles)
                                        {
                                            <option value="@u.Id" selected="@(u.Id == trabajo.IdUsuario)">@u.Nombre @u.Apellido</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label">Horas</label>
                                    <input type="number" step="1" name="HsHombre" class="form-control" value="@trabajo.HsHombre.ToString("0", System.Globalization.CultureInfo.InvariantCulture)" />
                                </div>
                                <input type="hidden" name="TarifaHsHombre" value="0" />
                                <div class="col-md-1 d-flex align-items-end">
                                    <button type="submit" class="btn btn-primary w-100">OK</button>
                                </div>
                            </div>
                        </form>
                    </div>
                }

                <div class="table-responsive tabla-scroll mt-3">
                    <table class="table table-sm table-striped align-middle mb-0">
                        <thead class="table-light"><tr><th>Material</th><th>Cantidad</th><th class="text-end">Acciones</th></tr></thead>
                        <tbody>
                        @foreach (var insumo in trabajo.Insumos)
                        {
                            <tr>
                                <td>@(string.IsNullOrWhiteSpace(insumo.NombreInsumo) ? $"Insumo #{insumo.IdInsumo}" : insumo.NombreInsumo)</td>
                                <td>@insumo.Cantidad</td>
                                <td class="text-end">
                                    @if (!bloqueado)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="collapse" data-bs-target="#formInsumo-@insumo.Id">Editar</button>
                                    }
                                </td>
                            </tr>
                            @if (!bloqueado)
                            {
                                <tr class="collapse" id="formInsumo-@insumo.Id">
                                    <td colspan="3">
                                        <form class="form-ajax-gestion" method="post"
                                              action="/InsumosPorTrabajo/GuardarAjax" data-idturno="@Model.Turno.Id">
                    @Html.AntiForgeryToken()
                                            <input type="hidden" name="Id" value="@insumo.Id" />
                                            <input type="hidden" name="IdTrabajoTurno" value="@trabajo.Id" />
                                            <div class="row g-2">
                                                <div class="col-md-5">
                                                    <select name="IdInsumo" class="form-select">
                                                        @foreach (var i in Model.InsumosDisponibles)
                                                        {
                                                            <option value="@i.Id" selected="@(i.Id == insumo.IdInsumo)">@i.Nombre</option>
                                                        }
                                                    </select>
                                                </div>
                                                <div class="col-md-3">
                                                    <input type="number" name="Cantidad" class="form-control" value="@insumo.Cantidad" placeholder="Cantidad" />
                                                </div>
                                                <div class="col-md-2">
                                                    <button type="submit" class="btn btn-primary w-100">OK</button>
                                                </div>
                                            </div>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        </tbody>
                    </table>
                </div>

                @if (!bloqueado)
                {
                    <button type="button" class="btn btn-sm btn-outline-success mt-3" data-bs-toggle="collapse" data-bs-target="#formNuevoInsumo-@trabajo.Id">Agregar material</button>
                    <div class="collapse mt-3" id="formNuevoInsumo-@trabajo.Id">
                        <form class="form-ajax-gestion border-top pt-3" method="post"
                              action="/InsumosPorTrabajo/GuardarAjax" data-idturno="@Model.Turno.Id">
                    @Html.AntiForgeryToken()
                            <input type="hidden" name="Id" value="0" />
                            <input type="hidden" name="IdTrabajoTurno" value="@trabajo.Id" />
                            <div class="row g-2">
                                <div class="col-md-6">
                                    <select name="IdInsumo" class="form-select">
                                        <option value="">Seleccione un insumo</option>
                                        @foreach (var i in Model.InsumosDisponibles)
                                        {
                                            <option value="@i.Id">@i.Nombre</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-3">
                                    <input type="number" name="Cantidad" class="form-control" placeholder="Cantidad" />
                                </div>
                                <div class="col-md-3">
                                    <button type="submit" class="btn btn-success w-100">Agregar</button>
                                </div>
                            </div>
                        </form>
                    </div>
                }
            </div>
        </div>
    }
}

@if (!bloqueado)
{
    <button type="button" class="btn btn-sm btn-outline-success mt-2" data-bs-toggle="collapse" data-bs-target="#formNuevoTrabajo">Agregar trabajo</button>
    <div class="collapse mt-3" id="formNuevoTrabajo">
        <form class="form-ajax-gestion card shadow-sm border-0 p-3" method="post"
              action="/TrabajosPorTurno/GuardarAjax" data-idturno="@Model.Turno.Id">
                    @Html.AntiForgeryToken()
            <input type="hidden" name="Id" value="0" />
            <input type="hidden" name="IdTurno" value="@Model.Turno.Id" />
            <div class="row g-2">
                <div class="col-md-4">
                    <label class="form-label">Trabajo</label>
                    <select name="IdTrabajo" class="form-select">
                        <option value="">Seleccione un trabajo</option>
                        @foreach (var t in Model.TrabajosDisponibles)
                        {
                            <option value="@t.Id">@t.Nombre</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Usuario</label>
                    <select name="IdUsuario" class="form-select">
                        <option value="">Seleccione un usuario</option>
                        @foreach (var u in Model.UsuariosDisponibles)
                        {
                            <option value="@u.Id">@u.Nombre @u.Apellido</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Horas</label>
                    <input type="number" step="1" name="HsHombre" class="form-control" />
                </div>
                <input type="hidden" name="TarifaHsHombre" value="0" />
                <div class="col-md-1 d-flex align-items-end">
                    <button type="submit" class="btn btn-success w-100">Agregar</button>
                </div>
            </div>
        </form>
    </div>
}
