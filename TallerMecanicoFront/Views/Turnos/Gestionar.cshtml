@model TallerMecanicoFront.Models.TurnoGestionViewModel
@{
    ViewData["Title"] = $"Gestión del turno {Model.Turno.Id}";
    var bloqueado = !Model.PuedeEditar;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-1">Gestión del turno N° @Model.Turno.Id</h1>
        <div class="text-muted">@Model.Turno.Fecha.ToString("dd/MM/yyyy") · Cliente @Model.Turno.IdCliente · Máquina @Model.Turno.IdMaquina</div>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">Volver a turnos</a>
</div>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="h5 mb-0">Detalle operativo</h2>
            @if (Model.Detalle is null)
            {
                <a asp-controller="DetallesTurnos" asp-action="Create" asp-route-turnoId="@Model.Turno.Id" class="btn btn-sm btn-outline-primary">Agregar detalle</a>
            }
            else
            {
                <a asp-controller="DetallesTurnos" asp-action="Edit" asp-route-id="@Model.Detalle.Id" class="btn btn-sm btn-outline-primary">Editar detalle</a>
            }
        </div>
        @if (Model.Detalle is null)
        {
            <p class="text-muted mb-0">Todavía no se cargó el domicilio ni la localidad del trabajo.</p>
        }
        else
        {
            <dl class="row mb-0">
                <dt class="col-sm-3">Domicilio</dt>
                <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Detalle.DomicilioTrabajo) ? "-" : Model.Detalle.DomicilioTrabajo)</dd>
                <dt class="col-sm-3">Localidad</dt>
                <dd class="col-sm-9">@(Model.Detalle.IdLocalidad?.ToString() ?? "-")</dd>
            </dl>
        }
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h5 mb-0">Mano de obra y materiales</h2>
</div>

@if (!Model.Trabajos.Any())
{
    <div class="alert alert-light border">No hay trabajos cargados para este turno.</div>
}
else
{
    foreach (var trabajo in Model.Trabajos)
    {
        <div class="card shadow-sm border-0 mb-3">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-sm table-striped align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Trabajo</th>
                                <th>Usuario</th>
                                <th>Horas</th>
                                <th>Tarifa</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>@(string.IsNullOrWhiteSpace(trabajo.NombreTrabajo) ? $"Trabajo #{trabajo.IdTrabajo}" : trabajo.NombreTrabajo)</td>
                                <td>@(string.IsNullOrWhiteSpace(trabajo.NombreUsuario) ? $"Usuario #{trabajo.IdUsuario}" : trabajo.NombreUsuario)</td>
                                <td>@trabajo.HsHombre.ToString("0.00")</td>
                                <td>$@trabajo.TarifaHsHombre.ToString("0.00")</td>
                                <td class="text-end">
                                    @if (!bloqueado)
                                    {
                                        <a asp-controller="TrabajosPorTurno" asp-action="Edit" asp-route-id="@trabajo.Id" class="btn btn-sm btn-outline-primary">Editar trabajo</a>
                                    }
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div class="table-responsive mt-3">
                    <table class="table table-sm table-striped align-middle mb-0">
                        <thead class="table-light"><tr><th>Material</th><th>Cantidad</th><th>Costo</th><th class="text-end">Acciones</th></tr></thead>
                        <tbody>
                        @foreach (var insumo in trabajo.Insumos)
                        {
                            <tr>
                                <td>@(string.IsNullOrWhiteSpace(insumo.NombreInsumo) ? $"Insumo #{insumo.IdInsumo}" : insumo.NombreInsumo)</td>
                                <td>@insumo.Cantidad</td>
                                <td>$@insumo.CostoInsumo.ToString("0.00")</td>
                                <td class="text-end"><a asp-controller="InsumosPorTrabajo" asp-action="Edit" asp-route-id="@insumo.Id" class="btn btn-sm btn-outline-primary">Editar</a></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
                @if (!bloqueado)
                {
                    <a asp-controller="InsumosPorTrabajo" asp-action="Create" asp-route-trabajoId="@trabajo.Id" class="btn btn-sm btn-outline-success mt-3">Agregar material</a>
                }
            </div>
        </div>
    }

    @if (!bloqueado)
    {
        <a asp-controller="TrabajosPorTurno" asp-action="Create" asp-route-turnoId="@Model.Turno.Id" class="btn btn-sm btn-outline-success mt-2">Agregar trabajo</a>
    }
}