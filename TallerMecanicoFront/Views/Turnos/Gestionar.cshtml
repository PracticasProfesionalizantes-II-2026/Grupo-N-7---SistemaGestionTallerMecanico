@model TallerMecanicoFront.Models.TurnoGestionViewModel
@{
    ViewData["Title"] = $"Gestión del turno {Model.Turno.Id}";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-1">Gestión del turno N° @Model.Turno.Id</h1>
        <div class="text-muted">@Model.Turno.Fecha.ToString("dd/MM/yyyy") · Cliente @Model.Turno.IdCliente · Máquina @Model.Turno.IdMaquina</div>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">Volver a turnos</a>
</div>

<div id="contenido">
    <partial name="_GestionContenido" model="Model" />
</div>

@section Scripts {
    <script>
        // Delegado en #contenido (no en cada form) para que siga funcionando
        // después de que el contenido se reemplace por la respuesta del fetch.
        document.getElementById('contenido').addEventListener('submit', async function (evento) {
            var form = evento.target;
            if (!form.classList.contains('form-ajax-gestion')) {
                return;
            }
            evento.preventDefault();

            var boton = form.querySelector('button[type="submit"]');
            if (boton) { boton.disabled = true; }

            try {
                var respuesta = await fetch(form.action, {
                    method: 'POST',
                    body: new FormData(form)
                });
                var html = await respuesta.text();
                document.getElementById('contenido').innerHTML = html;
            } catch (error) {
                if (boton) { boton.disabled = false; }
            }
        });
    </script>
}
