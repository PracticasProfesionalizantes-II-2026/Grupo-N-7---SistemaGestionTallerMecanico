@model IEnumerable<TallerMecanicoFront.Models.Turno>
@using TallerMecanicoFront.Models
@{
    ViewData["Title"] = "Turnos";
    var estadosTurno = ViewBag.EstadosTurno as IEnumerable<EstadoTurno> ?? Enumerable.Empty<EstadoTurno>();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Turnos</h1>
    <a asp-action="Create" class="btn btn-primary">Nuevo Turno</a>
</div>

@if (TempData["Error"] is not null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (!ViewData.ModelState.IsValid)
{
    <div asp-validation-summary="All" class="alert alert-danger"></div>
}

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Id</th>
                <th>Cliente</th>
                <th>Máquina</th>
                <th>Tipo</th>
                <th>Fecha</th>
                <th>Estado</th>
                <th>Descripción</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.IdCliente</td>
                        <td>@item.IdMaquina</td>
                        <td>@(item.IdTipoTurno ?? 0)</td>
                        <td>@item.Fecha.ToString("dd/MM/yyyy")</td>
                        <td>@(item.IdEstado ?? 0)</td>
                        <td>@(string.IsNullOrWhiteSpace(item.Descripcion) ? "-" : item.Descripcion)</td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-2">
                                @if (!estadosTurno.Any(estado => estado.Id == item.IdEstado && (string.Equals(estado.Nombre?.Trim(), "Finalizado", StringComparison.OrdinalIgnoreCase) || string.Equals(estado.Nombre?.Trim(), "Cerrado", StringComparison.OrdinalIgnoreCase))))
                                {
                                    <a asp-controller="TrabajosPorTurno" asp-action="Create" asp-route-turnoId="@item.Id" class="btn btn-sm btn-outline-success">Agregar detalle</a>
                                }
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('¿Seguro que deseas eliminar este turno?');">
                                        Eliminar
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="8" class="text-center text-muted py-4">No hay turnos registrados.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
